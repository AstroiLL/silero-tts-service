# silero-tts-service — настройки. install.sh скопирует в .env (права 600).

# Где слушать. 127.0.0.1 — только этот сервер (все его пользователи);
# 0.0.0.0 — ещё и другие машины в локальной сети (доступ всё равно только по токенам).
SILERO_HOST=127.0.0.1
SILERO_PORT=7470

# Модель и голос по умолчанию: aidar, baya, kseniya, xenia, eugene (мужские — aidar, eugene).
# Клиент может выбрать голос в каждом запросе; голоса OpenAI (alloy и др.) заменяются этим.
SILERO_MODEL=v5_5_ru
SILERO_VOICE=eugene
# Темп по умолчанию (клиент может прислать свой speed). 1.0 = обычный.
SILERO_SPEED=1.0

# Потоков CPU на синтез (пусто = половина ядер). Максимальная длина текста в запросе.
SILERO_THREADS=
SILERO_MAX_CHARS=10000

# Где лежат модели и токены (пусто = рядом с server.py: models/, tokens.json).
SILERO_MODEL_DIR=
SILERO_TOKENS=
